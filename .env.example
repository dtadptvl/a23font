# A23Font environment
# A23FONT_DATA_ROOT is the container volume /data in production images.
# On bare metal, point it at a local directory instead (e.g. /srv/a23font/data).
A23FONT_DATA_ROOT=/data
A23FONT_HTTP_HOST=0.0.0.0
A23FONT_HTTP_PORT=8090
A23FONT_PUBLIC_BASE_URL=https://font.esma.eu.org
# Pipeline tuning (fast15.md production defaults; tune per A23 measurements)
A23FONT_HTTP_CONCURRENCY=8
A23FONT_GLYPH_WORKERS=2
A23FONT_BROWSER_SESSIONS=1
A23FONT_ATLAS_TARGET_MB=96
A23FONT_ATLAS_MAX_MB=128
A23FONT_CHECKPOINT_BATCH=16
A23FONT_EXECUTION_BUDGET_MINUTES=15
A23FONT_BROWSER_ENABLED=true
A23FONT_CHROMIUM_PATH=chromium
# Job system
A23FONT_MAX_QUEUE=3
A23FONT_MAX_ACTIVE_COLLECTIONS=1
# Logging
A23FONT_LOG_LEVEL=INFO

# Pipeline network gate (T-006 milestone): live myfonts.com resolution, gmap
# discovery and raster fetches are DISABLED off-A23. Jobs claimed while false
# fail honestly with NETWORK_DISABLED. T-007 enables this on the real A23.
A23FONT_PIPELINE_LIVE=false
# Extra allowed hosts for live pipeline fetches (comma-separated), added to
# the sig.monotype.com raster allowlist. Only needed if the raster endpoint
# redirects to a CDN host; keep the list minimal (empty unless required).
A23FONT_EXTRA_SOURCE_HOSTS=""